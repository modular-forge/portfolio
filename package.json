{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:validate": "depcruise src",
    "knip": "knip",
    "prepare": "husky",
    "check": "npm run format:check && npm run lint && npm run lint:styles && npm run deps:validate && npm run knip",
    "test:ci": "ng test --watch=false --coverage"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^5.1.1",
    "angular-eslint": "22.8.0",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "knip": "^6.47.0",
    "prettier": "^3.10.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
