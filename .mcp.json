{
  "mcpServers": {
    "angular-cli": {
      "command": "cmd",
      "args": ["/c", "npx", "ng", "mcp"]
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@0.0.83", "--isolated", "--headless"]
    },
    "chrome-devtools": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@1.10.1",
        "--isolated",
        "--no-usage-statistics"
      ]
    }
  }
}
